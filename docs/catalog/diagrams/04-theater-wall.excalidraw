      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945974500,
      "link": null,
      "locked": false,
      "text": "Panel ① is the brain. Only the Agent panel drives state; ② and ③ mirror it from a broadcast\nsnapshot, so they can never disagree with what the audience just did.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Panel ① is the brain. Only the Agent panel drives state; ② and ③ mirror it from a broadcast\nsnapshot, so they can never disagree with what the audience just did.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ETsa9xb8114wOf72a5L2t",
      "type": "text",
      "x": 60,
      "y": 670,
      "width": 612.18017578125,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#b4283f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1431606834,
      "version": 2,
      "versionNonce": 791950766,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945974500,
      "link": null,
      "locked": false,
      "text": "⚠  Sync needs ONE shared HTTPS origin. On file:// paths each window is a separate opaque\n    origin and the panels silently stop syncing. Always launch from the hosted URL.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚠  Sync needs ONE shared HTTPS origin. On file:// paths each window is a separate opaque\n    origin and the panels silently stop syncing. Always launch from the hosted URL.",
      "autoResize": true,
      "lineHeight": 1.25
    },
