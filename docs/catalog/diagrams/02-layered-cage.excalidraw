    {
      "id": "mpEaNOIv5wQ2-1E251hmC",
      "type": "text",
      "x": 40,
      "y": 300,
      "width": 152.5439453125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#5b6b7f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 237484658,
      "version": 2,
      "versionNonce": 1349123250,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945974210,
      "link": null,
      "locked": false,
      "text": "Identity first.\n\nAn agent is a workload\nidentity. Disabling it is\nthe decisive control.\n\nData revocation is the\nbackstop for the window\nwhere an issued token\nis still valid.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Identity first.\n\nAn agent is a workload\nidentity. Disabling it is\nthe decisive control.\n\nData revocation is the\nbackstop for the window\nwhere an issued token\nis still valid.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x86Kmo5dkoZffhOQYl2cM",
      "type": "text",
      "x": 40,
      "y": 700,
      "width": 610.40771484375,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#5b6b7f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 354213294,
      "version": 2,
      "versionNonce": 1086775150,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945974210,
      "link": null,
      "locked": false,
      "text": "Network is added for exfiltration, C2 or High severity. The compute layer is the patient-safety\nkill switch and is gated on purpose: a real SOC puts an approval in front of that blast radius,\nso it sits behind a Settings toggle. Turning it off is a good way to show graduated response.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Network is added for exfiltration, C2 or High severity. The compute layer is the patient-safety\nkill switch and is gated on purpose: a real SOC puts an approval in front of that blast radius,\nso it sits behind a Settings toggle. Turning it off is a good way to show graduated response.",
      "autoResize": true,
      "lineHeight": 1.25
    },
