      "updated": 1787945973759,
      "link": null,
      "locked": false,
      "text": "Detection surfaces ~15s after the prompt.  Containment then runs 18-22 steps at ~0.6s each,\nso the agent is fully caged about 26-28 seconds after the attack.  Both are tunable in Settings.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Detection surfaces ~15s after the prompt.  Containment then runs 18-22 steps at ~0.6s each,\nso the agent is fully caged about 26-28 seconds after the attack.  Both are tunable in Settings.",
      "autoResize": true,
      "lineHeight": 1.25
    },
