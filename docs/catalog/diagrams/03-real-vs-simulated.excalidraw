      "updated": 1787945974358,
      "link": null,
      "locked": false,
      "text": "\"The detection pipeline is simulated so this runs anywhere with no tenant and no cost.\n What is not simulated is the shape of it. Every alert ID, severity and tactic on that screen is\n transcribed from Microsoft's published catalog, and the containment steps are the real Graph\n and Azure operations a playbook would call.\"",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"The detection pipeline is simulated so this runs anywhere with no tenant and no cost.\n What is not simulated is the shape of it. Every alert ID, severity and tactic on that screen is\n transcribed from Microsoft's published catalog, and the containment steps are the real Graph\n and Azure operations a playbook would call.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
