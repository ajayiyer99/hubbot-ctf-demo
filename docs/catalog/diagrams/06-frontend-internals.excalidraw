      "link": null,
      "locked": false,
      "text": "Scoring happens on the way IN, before the model answers, because detection is on the inbound\nprompt. Output-side checks then confirm a compromise. Mock is deterministic and offline, which\nis what you want in front of an audience.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scoring happens on the way IN, before the model answers, because detection is on the inbound\nprompt. Output-side checks then confirm a compromise. Mock is deterministic and offline, which\nis what you want in front of an audience.",
      "autoResize": true,
      "lineHeight": 1.25
    },
